# Copy this file to .env and fill in your own values. Never commit the .env file.

# Spring profile: dev or prod
SPRING_PROFILES_ACTIVE=dev

# MySQL
DATABASE_URL=jdbc:mysql://localhost:3306/wineinventory?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true
DATABASE_USER=root
DATABASE_PASSWORD=change-me

# JWT (at least 32 characters, for example: openssl rand -base64 48)
JWT_SECRET=change-me-with-a-random-string-of-at-least-32-characters
JWT_EXPIRATION_DAYS=7

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend and CORS (comma separated origins)
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200

# PayPal (sandbox by default)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
PAYPAL_RETURN_URL=http://localhost:8080/api/v1/subscriptions/paypal/return
PAYPAL_CANCEL_URL=http://localhost:8080/api/v1/subscriptions/paypal/cancel
